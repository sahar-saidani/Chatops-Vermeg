JENKINS_URL=http://localhost:8000
JENKINS_USERNAME=sahar
JENKINS_TOKEN=replace-me
LOG_LEVEL=INFO
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Per-machine tenant/environment identity - required, config-driven.
# Do not branch application code on TENANT_NAME; every client (MAIF, NNBN,
# CVT, and any future one) runs the exact same code with a different .env.
TENANT_NAME=MAIF
ENVIRONMENT_NAME=DEV
ENVIRONMENT_TYPE=STANDALONE
MACHINE_REFERENCE=MAIF-DEV-JENKINS-01
# NODE_ROLE=MASTER   # required (MASTER|SLAVE) only when ENVIRONMENT_TYPE=CLUSTER

# This agent runs on two dedicated machines per client/environment - one
# builds RELEASE jobs, the other SNAPSHOT jobs. Same code, different value.
JENKINS_PURPOSE=RELEASE
