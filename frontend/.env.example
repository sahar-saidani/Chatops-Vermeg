# Spring Boot REST API. Port comes from server.port in
# src/main/resources/application.yml.
VITE_API_URL=http://localhost:8080

# Python FastAPI LLM orchestrator. Port comes from the uvicorn.run(...) call in
# llm-orchestrator/main.py, which binds 127.0.0.1:8100.
VITE_ORCHESTRATOR_URL=http://localhost:8100
