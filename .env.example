# ChatOps Vermeg - required environment variables.
#
# Copy to .env and fill in real values. Never commit the filled-in copy.
# Every key below was taken from an actual ${...} placeholder in
# src/main/resources/application*.yml or llm-orchestrator/config/settings.py.

# ---------------------------------------------------------------- Spring Boot
# HMAC signing key for access tokens. REQUIRED - there is no default, and the
# application refuses to issue or verify a token without it.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=3600000
REFRESH_TOKEN_EXPIRATION=2592000000

# PostgreSQL (the dev profile defaults to localhost:5432/chatops)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sahar

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Outgoing mail for invitations and password resets
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
AUTH_MAIL_FROM=no-reply@chatops-vermeg.local

# Where invitation and reset links point, i.e. the frontend origin.
AUTH_FRONTEND_BASE_URL=http://localhost:5173

# Browser origins allowed to call the API, comma-separated.
# Wildcards are not supported because credentials are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443

# Shared secret the LLM orchestrator presents as X-Internal-Api-Key when
# writing conversation history. Must be identical on both sides. Leaving it
# empty makes the internal endpoints reject every caller, so conversation
# history simply will not be saved.
INTERNAL_API_KEY=

# ------------------------------------------------------------ LLM orchestrator
# Where the orchestrator reaches the Spring API.
SPRING_API_BASE_URL=http://localhost:8080

# OpenRouter credentials for the response analyzer. Without a key the
# orchestrator falls back to rule-based intent detection only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agent execution bounds.
AGENT_SUBPROCESS_TIMEOUT_SECONDS=300
AGENT_FRESH_DATA_TIMEOUT_SECONDS=60

# Default tenant when a request does not name one; must exist in
# llm-orchestrator/config/tenant_machines.yml.
DEFAULT_TENANT=MAIF

# ------------------------------------------------------------ Agents (scanner)
# Bounds on an installation-agent scan. Defaults live in
# installation-agent/app/config/settings.py; override only to widen a scan.
AGENT_MAX_SCAN_DEPTH=12
AGENT_MAX_SCAN_FILES=20000
AGENT_MAX_SCAN_SECONDS=180
AGENT_FOLLOW_SYMLINKS=false
