# PostgreSQL (same database the Spring Boot Data Processing Agent writes to)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sahar

# Spring Boot REST API base URL (conversation history persistence, auth introspection)
SPRING_API_BASE_URL=http://localhost:8080

# AgentRouter API (OpenAI-compatible) used for intent fallback + final answer generation
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-120b:free

# How long to wait for fresh canonical_events data after launching agents (seconds)
AGENT_FRESH_DATA_TIMEOUT_SECONDS=60
AGENT_FRESH_DATA_POLL_INTERVAL_SECONDS=2

# Per-agent timeout for subprocess execution (seconds)
AGENT_SUBPROCESS_TIMEOUT_SECONDS=300

# Root directory containing all Python collection agents (defaults to repo root's parent of this folder)
AGENTS_ROOT_DIR=..

LOG_LEVEL=INFO
